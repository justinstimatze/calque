# Python — only internal/code/extract.py remains (the embedded AST extractor,
# run as a subprocess); these guard its incidental artifacts.
__pycache__/
*.pyc

# Go
/calque
*.test

# Secrets — the API key for the LLM judge (propose-deep --judge). NEVER commit.
.env
.env.*
!.env.example

# Node — dev-only TS toolchain for the TypeScript extractor (extract_ts.mjs).
# package.json + package-lock.json are tracked (they pin typescript for dogfooding
# and CI); the installed tree is not.
node_modules/

# Rust — the syn extractor crate is built once into the user cache dir, not in-tree.
# Cargo.toml/Cargo.lock/src are tracked (embedded + pinned); guard against an
# accidental in-tree `cargo build` leaving a target/ behind.
internal/code/rust-extractor/target/

# calque's own memory: track the adjudicated registry + prose allow-list,
# ignore calibration logs (fires.jsonl / fire-tags.jsonl)
.calque/*
!.calque/registry.md
!.calque/vocab-allowlist.txt

# defn — regenerated per-clone by `defn init` (.mcp.json bakes in absolute local
# paths; CLAUDE.md is auto-generated). Not committed.
.defn/
.codex/
.mcp.json
CLAUDE.md

# Claude Code local runtime state (scheduled-task locks, etc.)
.claude/

# plancheck debug artifact
.plancheck-debug.json
